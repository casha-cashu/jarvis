# Stage 1: base
FROM debian:bookworm-slim AS base
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip python3-venv python3-dev portaudio19-dev \
    libnotify-bin wtype xdotool espeak-ng git build-essential \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY . .
RUN python3 -m venv venv && venv/bin/pip install --upgrade pip setuptools && \
    venv/bin/pip install -e ".[dev]"

# Stage 2: integration
FROM base AS integration
RUN apt-get update && apt-get install -y \
    sway seatd wlr-randr grim slurp wtype foot libnotify-bin \
    dbus dbus-x11 strace \
    && rm -rf /var/lib/apt/lists/*
COPY docker/sway/config /etc/sway/config
COPY docker/sway/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
ENV WLR_BACKENDS=headless
ENV WLR_LIBINPUT_NO_DEVICES=1
ENV WLR_RENDERER=pixman
ENV LIBSEAT_BACKEND=builtin
ENTRYPOINT ["/entrypoint.sh"]
