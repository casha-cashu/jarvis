# syntax=docker/dockerfile:1
FROM fedora:latest

# Отключаем openh264 (403 forbidden на GitHub Actions) и ставим нужное
RUN dnf config-manager --set-disabled fedora-cisco-openh264 2>/dev/null; \
    dnf install -y --setopt=retries=5 \
        python3 \
        python3-pip \
        python3-devel \
        portaudio-devel \
        libnotify \
        wtype \
        xdotool \
        git \
        gcc \
        make \
    && dnf clean all

WORKDIR /app
# Слои: манифесты -> deps (кэшируются) -> исходники. Любой чих репо
# больше не перекачивает torch.
COPY pyproject.toml requirements.txt ./
RUN python3 -m venv venv && \
    venv/bin/pip install --upgrade pip setuptools wheel && \
    venv/bin/pip install --retries 5 --timeout 120 torch --index-url https://download.pytorch.org/whl/cpu && \
    venv/bin/pip install --retries 5 --timeout 120 -r requirements.txt pytest pytest-cov pytest-mock pytest-timeout
COPY . .
RUN venv/bin/pip install -e ".[dev]" --no-deps

CMD ["venv/bin/python", "-m", "pytest", "tests/", "-v", "-m", "not slow and not integration"]
