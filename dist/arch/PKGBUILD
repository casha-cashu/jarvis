# Maintainer: JARVIS Team <jarvis@example.com>

pkgname=jarvis
pkgver=2.9.0
pkgrel=1
pkgdesc="JARVIS — голосовой ассистент для Linux/macOS (Tauri 2 + React 19 + Rust bridge)"
arch=('x86_64')
url="https://github.com/casha-cashu/jarvis"
license=('MIT')
depends=('webkit2gtk-4.1' 'gtk3' 'portaudio' 'mpv' 'wl-clipboard' 'wtype')
optdepends=(
    'grim: Wayland screenshot tool'
    'slurp: Wayland interactive screen area selector'
    'xdotool: X11 simulated keystrokes'
    'xclip: X11 clipboard integration'
)
# Локальная сборка: ожидается JARVIS_${pkgver}_amd64.deb рядом с PKGBUILD (симлинк/копия из jarvis-ui/src-tauri/target/release/bundle/deb/)
# Для AUR заменить на:
# source=("JARVIS_${pkgver}_amd64.deb::https://github.com/casha-cashu/jarvis/releases/download/v${pkgver}/JARVIS_${pkgver}_amd64.deb")
source=("JARVIS_${pkgver}_amd64.deb")
sha256sums=('SKIP')
# Для AUR с URL выше использовать реальный sha256 (обновить при бампе):
# sha256sums=('33a6813d3b3e0beb7983e4cbe674e6e5a1806f39831ab09fe77f6d1cc54d40f2')

package() {
    # .deb — ar-архив: debian-binary, control.tar.gz, data.tar.gz
    # Распаковываем data.tar.gz из deb во временный srcdir, затем его содержимое в $pkgdir.
    # bsdtar умеет читать ar (проверено: debian-binary, control.tar.gz, data.tar.gz)
    # Такой двухступенчатый подход чище чем `bsdtar -Oxf deb data.tar.gz | bsdtar -xC $pkgdir`
    # и совместим со всеми версиями libarchive. Итоговый .pkg.tar.zst содержит только /usr/...,
    # сам .deb внутрь пакета не попадает (проверяется `tar -tf *.pkg.tar.zst | grep deb` → пусто).
    bsdtar -xf "$srcdir/JARVIS_${pkgver}_amd64.deb" -C "$srcdir"
    bsdtar -xf "$srcdir/data.tar.gz" -C "$pkgdir"

    # Права 755 для бинарников
    if [[ -f "$pkgdir/usr/bin/jarvis" ]]; then chmod 755 "$pkgdir/usr/bin/jarvis"; fi
    if [[ -f "$pkgdir/usr/bin/jarvis-bridge" ]]; then chmod 755 "$pkgdir/usr/bin/jarvis-bridge"; fi


    # Контент из deb (для справки, устанавливается автоматически из data.tar.gz):
    #   /usr/bin/jarvis                      — Tauri WebView (11M, ELF) с 0.2.1 (ранее app)
    #   /usr/bin/jarvis-bridge               — Python bridge (158M, ELF)
    #   /usr/lib/JARVIS/_up_/_up_/config.example.yaml
    #   /usr/share/applications/JARVIS.desktop (Exec=jarvis)
    #   /usr/share/icons/hicolor/{32x32,128x128,256x256@2}/apps/app.png

    # Лицензия (чтобы закрыть namcap E: MIT requires license file)
    # $startdir = dist/arch, LICENSE лежит в корне репо (../../LICENSE от $startdir)
    if [[ -f "$startdir/../../LICENSE" ]]; then
        install -Dm644 "$startdir/../../LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    fi

    # man-page
    if [[ -f "$startdir/../../docs/jarvis.1" ]]; then
        install -Dm644 "$startdir/../../docs/jarvis.1" "$pkgdir/usr/share/man/man1/jarvis.1"
    fi
}
