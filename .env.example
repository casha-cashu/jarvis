# Environment variables for JARVIS
# Скопируй в .env и заполни свои ключи
# cp .env.example .env

# === ОСНОВНОЙ ПРОВАЙДЕР (Kiro AI / Omniroute) ===
# Локальный эндпоинт с Claude Sonnet 4.5
export KIRO_API_KEY="your_kiro_api_key_here"
# KIRO_BASE_URL="http://localhost:20128/v1"  # опционально

# === FALLBACK ПРОВАЙДЕР (OpenRouter) ===
# Раскомментируй если есть ключ OpenRouter
# export OPENROUTER_API_KEY="your_openrouter_key_here"

# === FALLBACK ПРОВАЙДЕР (Anthropic прямой) ===
# Раскомментируй если есть прямой ключ Anthropic
# export ANTHROPIC_API_KEY="your_anthropic_key_here"

# === ЛОКАЛЬНАЯ МОДЕЛЬ (Ollama) ===
# Не требует ключей. Убедись что Ollama запущен:
#   ollama pull qwen2.5:3b
#   ollama serve
# Потом выбери ollama в меню при старте
