# Environment variables for JARVIS
# Скопируй в .env и заполни свои ключи
# cp .env.example .env

# === OpenAI (нативный API) ===
# export OPENAI_API_KEY="sk-..."

# === Anthropic (нативный API) ===
# export ANTHROPIC_API_KEY="sk-ant-..."

# === OpenRouter (OpenAI-compatible агрегатор) ===
# export OPENROUTER_API_KEY="sk-or-..."

# === ЛОКАЛЬНАЯ МОДЕЛЬ (Ollama) ===
# Не требует ключей. Убедись что Ollama запущен:
#   ollama pull qwen2.5:3b
#   ollama serve
# Потом выбери ollama в меню при старте (или `provider: ollama` в config.yaml)
